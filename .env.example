# Hugging Face token — required when llm.provider is huggingface in config.yaml.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: path to config file (default: config.yaml in project root)
# STORMY_CONFIG=config.yaml

# Optional: disable S3 uploads (same as `python main.py --local`)
# STORMY_UPLOAD_TO_S3=false

# Optional LLM overrides (take precedence over config.yaml)
# STORMY_LLM_PROVIDER=huggingface
# STORMY_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# STORMY_HF_INFERENCE_PROVIDER=deepinfra

# LangSmith tracing (set LANGSMITH_TRACING=true to enable)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=stormy-ai
